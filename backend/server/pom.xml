<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.officewallahgames</groupId>
        <artifactId>officewallahgames-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>server</artifactId>
    <packaging>jar</packaging>

    <name>Office Wallah Games - Unified Server</name>
    <description>Unified runtime packaging all services into a single lightweight Spring Boot container</description>

    <dependencies>
        <dependency>
            <groupId>com.officewallahgames</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.officewallahgames</groupId>
            <artifactId>games-master-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.officewallahgames</groupId>
            <artifactId>user-management-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.officewallahgames</groupId>
            <artifactId>tic-tac-toe-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.officewallahgames</groupId>
            <artifactId>ludo-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.officewallahgames</groupId>
            <artifactId>word-grid-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.officewallahgames</groupId>
            <artifactId>connect-drop-service</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <classifier></classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
