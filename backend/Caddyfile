:{$PORT:8080} {
    # Health check
    handle /health {
        respond "OK" 200
    }

    # Games Master Service
    handle /api/v1/games* {
        reverse_proxy localhost:8081
    }

    # User Management Service
    handle /api/v1/auth* {
        reverse_proxy localhost:8082
    }

    # Tic-Tac-Toe Arena (REST + WebSocket)
    handle /api/v1/tictactoe* {
        reverse_proxy localhost:8083
    }
    handle /ws/tictactoe* {
        reverse_proxy localhost:8083
    }

    # Ludo Royale (REST + WebSocket)
    handle /api/v1/ludo* {
        reverse_proxy localhost:8084
    }
    handle /ws/ludo* {
        reverse_proxy localhost:8084
    }

    # Word Grid Blitz (REST + WebSocket)
    handle /api/v1/wordgrid* {
        reverse_proxy localhost:8085
    }
    handle /ws/wordgrid* {
        reverse_proxy localhost:8085
    }

    # Connect Drop (REST + WebSocket)
    handle /api/v1/connectdrop* {
        reverse_proxy localhost:8086
    }
    handle /ws/connectdrop* {
        reverse_proxy localhost:8086
    }
}
